# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente do Midas
#
# Este arquivo NÃO tem valores reais. Para desenvolver, o .env.development
# (versionado, só com valores de localhost) já basta, junto com `docker compose up -d`.
# Para usar serviços reais na sua máquina, crie um .env.local (ignorado pelo git).
# Em produção, cadastre as variáveis no painel da Vercel.
# Nunca coloque segredos no repositório, em logs ou em mensagens de erro.
# ─────────────────────────────────────────────────────────────────────────────

# Banco de dados (PostgreSQL)
# No Neon, use a string com pooler (-pooler no host) aqui…
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.sa-east-1.aws.neon.tech/midas?sslmode=verify-full"
# …e a string direta (sem pooler) aqui, usada só pelas migrações.
DIRECT_URL="postgresql://USUARIO:SENHA@HOST.sa-east-1.aws.neon.tech/midas?sslmode=verify-full"

# Autenticação (Better Auth)
# Endereço público do app, com https e sem barra no fim. Em previews da Vercel pode ficar vazio.
BETTER_AUTH_URL="https://seu-dominio.com.br"
# 32 bytes aleatórios, um valor por ambiente. Gere com: openssl rand -base64 32
# Trocar este valor encerra todas as sessões.
BETTER_AUTH_SECRET=""

# E-mail (SMTP). Com uma conta Google: ative a verificação em 2 etapas e crie uma
# "senha de app" em https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="sua-conta@gmail.com"
SMTP_PASSWORD=""
EMAIL_FROM="Midas <sua-conta@gmail.com>"

# Recusar senhas que aparecem em vazamentos (Have I Been Pwned, k-anonimato:
# só os 5 primeiros caracteres do SHA-1 da senha saem do servidor).
PASSWORD_BREACH_CHECK="true"
