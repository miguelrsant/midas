// Banco do Midas.
// As tabelas User, Session, Account, Verification e RateLimit seguem o schema do
// Better Auth 1.7 (confira com `pnpm dlx auth@latest generate` ao atualizar a lib).
// Mapa de dados e bases legais: .lgpd/data-map.md e .lgpd/legal-basis.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id
  /// Nome ou apelido obrigatório ("Como você quer que o Midas te chame?"), para a saudação.
  name            String    @db.VarChar(40)
  email           String    @unique @db.VarChar(254)
  emailVerified   Boolean   @default(false)
  /// Campo do Better Auth. O Midas não guarda foto: fica sempre nulo.
  image           String?
  /// Versão dos termos e da política aceitos no cadastro (src/lib/legal.ts).
  termsVersion    String    @db.VarChar(20)
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        Session[]
  accounts        Account[]
  securityEvents  SecurityEvent[]
  entries         Entry[]
  recurrings      Recurring[]
  categories      UserCategory[]
  categoryLimits  CategoryLimit[]
  calculations    Calculation[]
  expectedIncomes ExpectedIncome[]
  preference      UserPreference?

  @@index([emailVerified, createdAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  /// Token da sessão. O cookie leva o token com uma assinatura HMAC (BETTER_AUTH_SECRET).
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Sempre nulo: o Midas não guarda IP (hook em src/lib/auth.ts).
  ipAddress String?
  /// Só o rótulo do aparelho ("Chrome no Android"), nunca o User-Agent completo.
  userAgent String?  @db.VarChar(60)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  /// Sempre "credential": só e-mail e senha.
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Hash Argon2id da senha (formato PHC). A senha nunca é guardada.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  /// Hash do token de confirmação de e-mail ou de nova senha.
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model RateLimit {
  id          String @id
  /// IP + rota. Vida curta: apagado pela limpeza depois de 1 dia.
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
  @@map("rate_limit")
}

enum SecurityEventType {
  SIGNUP
  LOGIN
  PASSWORD_CHANGED
  PASSWORD_RESET
  SESSIONS_REVOKED
  /// A pessoa baixou os dados em "Seus dados" (A009).
  DATA_EXPORTED
}

/// Trilha mínima de responsabilização (LGPD, art. 6º, X). Sem IP, sem e-mail, sem conteúdo.
model SecurityEvent {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SecurityEventType
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("security_event")
}

/// Contadores do próprio Midas: e-mails por destinatário e no total, e tentativas de
/// entrada por conta (src/lib/throttle.ts). A chave nunca leva o e-mail em claro, só
/// um HMAC com BETTER_AUTH_SECRET. Vida curta: apagado pela limpeza quando vence.
model Throttle {
  key       String   @id @db.VarChar(100)
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("throttle")
}

// ---------------------------------------------------------------------------
// Núcleo do produto (.lgpd/RIPD/ripd-lancamentos.md, A009–A014).
// Toda tabela com userId: ON DELETE CASCADE e presença na exportação de "Seus dados"
// (testes em src/lib/data/guards.integration.test.ts). CHECKs ficam na migração.
// Colunas "sealed"/"description"/"name" com texto livre são cifradas na aplicação
// (src/lib/crypto/fields.ts; .lgpd/encryption.md).
// ---------------------------------------------------------------------------

enum EntryKind {
  EXPENSE
  INCOME
}

/// @lgpd:activity=a010 @lgpd:legal_basis=art7-v,art11-ii-d @lgpd:retention=account @lgpd:sensitive=potential
model Entry {
  /// UUID gerado no aparelho: salvar duas vezes não duplica.
  id              String     @id @db.Uuid
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            EntryKind
  /// Centavos inteiros, de 1 a 999.999.999 (CHECK na migração).
  amountCents     Int
  /// Id de categoria pronta ("mercado") ou própria ("u-<uuid>").
  categoryId      String     @db.VarChar(40)
  /// Descrição opcional, cifrada (AAD: entry.description|userId|id).
  description     String?
  /// Dia do lançamento (sem hora), no calendário de São Paulo.
  date            DateTime   @db.Date
  /// Fixo que gerou este lançamento, se houver.
  recurringId     String?    @db.Uuid
  recurring       Recurring? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  /// Mês da ocorrência do fixo ("2026-09"); junto com recurringId, impede duplicar.
  occurrenceMonth String?    @db.Char(7)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([recurringId, occurrenceMonth])
  @@index([userId, date])
  @@map("entry")
}

/// @lgpd:activity=a014 @lgpd:legal_basis=art7-v,art11-ii-d @lgpd:retention=account @lgpd:sensitive=potential
model Recurring {
  id               String    @id @db.Uuid
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             EntryKind
  amountCents      Int
  categoryId       String    @db.VarChar(40)
  /// Nome do fixo, cifrado (AAD: recurring.description|userId|id).
  description      String?
  /// Dia do mês (1 a 31); meses mais curtos usam o último dia.
  dayOfMonth       Int       @db.SmallInt
  /// Primeiro mês ("2026-10").
  startMonth       String    @db.Char(7)
  /// Último mês, para parcelas e "só uma vez"; nulo = sem fim.
  endMonth         String?   @db.Char(7)
  /// Próxima ocorrência ainda não anotada; nulo = terminou.
  nextOccurrenceOn DateTime? @db.Date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  entries          Entry[]

  @@index([userId, nextOccurrenceOn])
  @@map("recurring")
}

/// @lgpd:activity=a013 @lgpd:legal_basis=art7-v,art11-ii-d @lgpd:retention=account @lgpd:sensitive=potential
model UserCategory {
  id        String    @id @db.Uuid
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      EntryKind
  /// Id da categoria pronta ajustada; nulo = categoria própria ("u-<id>").
  systemId  String?   @db.VarChar(40)
  /// {name, icon} cifrados juntos (AAD: user_category.sealed|userId|id); nulo = sem ajuste.
  sealed    String?
  hidden    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, systemId])
  @@index([userId])
  @@map("user_category")
}

/// @lgpd:activity=a012 @lgpd:legal_basis=art7-v,art11-ii-d @lgpd:retention=account @lgpd:sensitive=potential
model CategoryLimit {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String   @db.VarChar(40)
  amountCents Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, categoryId])
  @@map("category_limit")
}

enum CalculatorKind {
  VACATION
  THIRTEENTH
  TERMINATION
  NET_SALARY
  UNEMPLOYMENT
}

/// @lgpd:activity=a011 @lgpd:legal_basis=art7-v @lgpd:retention=account
model Calculation {
  /// Gerado no aparelho: "Adicionar ao planejamento" duas vezes não duplica.
  id              String           @id @db.Uuid
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            CalculatorKind
  /// {input, result, engineVersion, tableYear} cifrados (AAD: calculation.sealed|userId|id).
  sealed          String
  createdAt       DateTime         @default(now())
  expectedIncomes ExpectedIncome[]

  @@index([userId, createdAt])
  @@map("calculation")
}

/// @lgpd:activity=a014 @lgpd:legal_basis=art7-v @lgpd:retention=account
model ExpectedIncome {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String       @db.VarChar(40)
  /// Rótulo gerado pelo sistema ("decimo-terceiro-1"), nunca texto livre.
  labelKey      String       @db.VarChar(40)
  amountCents   Int
  dueDate       DateTime     @db.Date
  calculationId String?      @db.Uuid
  calculation   Calculation? @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([userId, dueDate])
  @@map("expected_income")
}

/// @lgpd:activity=a014 @lgpd:legal_basis=art7-v @lgpd:retention=account
model UserPreference {
  userId                 String   @id
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Último mês cujo resumo foi aberto ("2026-09"), para a conquista sumir.
  lastSummaryOpenedMonth String?  @db.Char(7)
  updatedAt              DateTime @updatedAt

  @@map("user_preference")
}

/// Contas apagadas, só o id, para reaplicar exclusões depois de um restore
/// (.lgpd/retention.md). Sem FK: a conta já não existe. Limpa em 8 dias.
/// @lgpd:activity=a009 @lgpd:legal_basis=art7-ii @lgpd:retention=8d
model DeletedAccount {
  id        String   @id
  deletedAt DateTime @default(now())

  @@index([deletedAt])
  @@map("deleted_account")
}
