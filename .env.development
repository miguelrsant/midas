# Valores de DESENVOLVIMENTO, seguros para versionar: só apontam para o
# Docker local (docker compose up -d). Nada aqui vale fora da sua máquina.
# Para sobrescrever algo, crie um .env.local (ignorado pelo git).

DATABASE_URL="postgresql://midas:midas@localhost:5432/midas"
DIRECT_URL="postgresql://midas:midas@localhost:5432/midas"

BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="dev-only-secret-nao-use-em-producao-0000000000"

# Mailpit: veja os e-mails em http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
EMAIL_FROM="Midas <nao-responda@midas.localhost>"

# Desligado no dev para funcionar sem internet; ligue no .env.local para testar.
PASSWORD_BREACH_CHECK="false"
